# ---------------------------------------------------------------- Core
DATABASE_URL=postgres://flowdeck:flowdeck@localhost:5432/flowdeck
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32  (encrypts GitHub tokens at rest)
ENCRYPTION_KEY=
LOG_LEVEL=info

# ---------------------------------------------------------------- Microsoft Entra ID
# App registration: redirect URI http://localhost:3000/api/auth/callback/microsoft
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Object ID of the Enterprise application (service principal). Lets the worker list
# the groups assigned to FlowDeck so admins can pick them by name.
# Needs the Microsoft Graph application permission Application.Read.All.
ENTRA_SERVICE_PRINCIPAL_ID=

# Local development without Entra: email + password sign-in.
# Never enable in production.
DEV_LOGIN=false
# Comma-separated emails treated as platform admins when DEV_LOGIN=true.
DEV_ADMIN_EMAILS=

# ---------------------------------------------------------------- GitHub
GITHUB_API_URL=https://api.github.com
# The DevOps repository that holds workflows and docs, e.g. acme/devops-workflows
CATALOG_REPOSITORY=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Azure OpenAI (search embeddings)
# Leave empty to run search with full-text only.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------- Email (Azure Communication Services)
# Leave empty to send in-app notifications only.
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# ---------------------------------------------------------------- Telemetry
# Leave empty to log JSON to stdout only (App Service collects it).
APPLICATIONINSIGHTS_CONNECTION_STRING=
