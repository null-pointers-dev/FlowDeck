{
  "name": "flowdeck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/db-setup.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@azure/monitor-opentelemetry": "^1.11.0",
    "@better-auth/drizzle-adapter": "^1.7.0",
    "@mantine/charts": "9.6.1",
    "@mantine/core": "9.6.1",
    "@mantine/form": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/modals": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@mantine/spotlight": "9.6.1",
    "@octokit/auth-app": "^8.0.0",
    "@octokit/rest": "^22.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@tabler/icons-react": "^3.34.0",
    "better-auth": "1.7.7",
    "bullmq": "6.3.9",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
